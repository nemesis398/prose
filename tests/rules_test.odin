package prose_tests

import "core:fmt"
import "core:os"
import "core:strconv"
import "core:strings"
import "core:testing"
import prose "../src"

// The Python reference's own regression test, ported as
// data: every deterministic rule fires on the fixture, and each known source
// of false positives stays silent there.

@(rodata)
MUST_FIRE := [?]string {
	"EM-DASH",
	"EM-DASH-CELL",
	"EN-DASH-EN",
	"EN-DASH-BUDGET",
	"EMOJI-POSITION",
	"EMOJI-COUNT",
	"EMOJI-DUPLICATE",
	"EMOJI-BODY",
	"EMOJI-LEGEND",
	"DE-UNIT-SPACE",
	"DE-THOUSANDS",
	"DE-DECIMAL",
	"DE-ABBREV-SPACE",
	"SPACE-BEFORE-PUNCT",
	"QUOTE-MIX",
	"AI-PHRASE",
	"DE-GLUE",
}

// A rule that must not fire on any excerpt holding `needle`.
@(private = "file")
Silent :: struct {
	rule, needle, what: string,
}

@(rodata)
MUST_NOT_FIRE := [?]Silent {
	{"DE-DECIMAL", "3.1.0", "version number read as a German decimal"},
	{"EM-DASH", "Dieser Kommentar", "em dash inside a fenced code block"},
	{"EM-DASH", "example.com", "em dash inside a URL"},
	{"EMOJI-BODY", "echo", "emoji inside a fenced code block"},
	{"EMOJI-BODY", "\u2192", "arrow misread as an emoji"},
	{"DOUBLE-SPACE", "Kriterium", "table cell padding read as double spacing"},
	{"DOUBLE-SPACE", "-------", "table delimiter row read as double spacing"},
}

@(test)
every_rule_fires_on_the_fixture :: proc(t: ^testing.T) {
	testing.expect_value(t, len(MUST_FIRE), 17)
	path := strings.concatenate({#directory, "corpus/fixture.md"})
	defer delete(path)
	data, rerr := os.read_entire_file(path, context.allocator)
	if !testing.expectf(t, rerr == nil, "read %s: %v", path, rerr) {
		return
	}
	defer delete(data)

	result, err := prose.check_text(string(data), {lang = "auto"})
	defer prose.file_result_destroy(&result)
	testing.expect_value(t, err.message, "")

	for rule in MUST_FIRE {
		hits := 0
		for f in result.findings {
			if f.rule == rule {
				hits += 1
			}
		}
		testing.expectf(t, hits > 0, "%s never fired on the fixture", rule)
	}
	for s in MUST_NOT_FIRE {
		for f in result.findings {
			if f.rule == s.rule && strings.contains(f.excerpt, s.needle) {
				testing.expectf(t, false, "%s fired at line %d: %s", s.rule, f.line, s.what)
				break
			}
		}
	}
}

// Snippets that hunt for the edges of each rule. The expected findings are
// the reference's, generated by running its check_text on
// each text with the same language and LanguageTool off, not written by hand.
@(private = "file")
Snippet :: struct {
	lang, text, note: string,
	want:             []prose.Finding,
}

// odinfmt: disable
@(rodata, private = "file")
SNIPPETS := [?]Snippet {
	// `\b` after `%` needs a word character next, so `1.5 %,` is silent and
	// `1.5 %x` fires; `min` beats `m` only because `m\b` fails before `i`.
	{
		lang = "de",
		text = "Der Wert liegt bei 1.5 %, nicht 1.5 GB und 2.0 min und 3.25mm und 1.5 %x.",
		note = "language: de",
		want = {
			{1, 33, .Warning, "DE-DECIMAL", "Decimal point in German text. German uses the comma: 3,5.", "Der Wert liegt bei 1.5 %, nicht 1.5 GB und 2.0 min und 3.25mm und 1.5 %x…", "1,5"},
			{1, 44, .Warning, "DE-DECIMAL", "Decimal point in German text. German uses the comma: 3,5.", "…liegt bei 1.5 %, nicht 1.5 GB und 2.0 min und 3.25mm und 1.5 %x.", "2,0"},
			{1, 56, .Warning, "DE-DECIMAL", "Decimal point in German text. German uses the comma: 3,5.", "…5 %, nicht 1.5 GB und 2.0 min und 3.25mm und 1.5 %x.", "3,25"},
			{1, 67, .Warning, "DE-DECIMAL", "Decimal point in German text. German uses the comma: 3,5.", "…1.5 GB und 2.0 min und 3.25mm und 1.5 %x.", "1,5"},
		},
	},
	// Every member of the em dash family, by its name.
	{
		lang = "en",
		text = "a \u2015 b \u2e3a c \u2e3b d \u2014 e",
		note = "language: en",
		want = {
			{1, 3, .Error, "EM-DASH", "horizontal bar in English prose. This character is never correct here.", "a \u2015 b \u2e3a c \u2e3b d \u2014 e", "restructure into a comma, colon, parenthesis or two sentences"},
			{1, 7, .Error, "EM-DASH", "two-em dash in English prose. This character is never correct here.", "a \u2015 b \u2e3a c \u2e3b d \u2014 e", "restructure into a comma, colon, parenthesis or two sentences"},
			{1, 11, .Error, "EM-DASH", "three-em dash in English prose. This character is never correct here.", "a \u2015 b \u2e3a c \u2e3b d \u2014 e", "restructure into a comma, colon, parenthesis or two sentences"},
			{1, 15, .Error, "EM-DASH", "em dash in English prose. This character is never correct here.", "a \u2015 b \u2e3a c \u2e3b d \u2014 e", "restructure into a comma, colon, parenthesis or two sentences"},
		},
	},
	// A dash alone in a cell is a placeholder; one inside cell text is prose.
	{
		lang = "auto",
		text = "| Kriterium | Wert |\n| --- | --- |\n| a | \u2014 |\n| b | x \u2014 y |\n",
		note = "language: en",
		want = {
			{3, 7, .Warning, "EM-DASH-CELL", "em dash as an empty-cell placeholder. Not prose, but it is still the character we are keeping out of these files.", "| a | \u2014 |", "use \u2013 or leave the cell empty"},
			{4, 9, .Error, "EM-DASH", "em dash in English prose. This character is never correct here.", "| b | x \u2014 y |", "restructure into a comma, colon, parenthesis or two sentences"},
		},
	},
	// Python's lower() turns the Kelvin sign into k. It turns the dotted
	// capital I into two code points, which made the reference report
	// "eamless" one column late; the port keeps offsets aligned, so this
	// expectation is the reference's corrected by hand.
	{
		lang = "en",
		text = "the \u212aey takeaway and \u0130 seamless",
		note = "language: en",
		want = {
			{1, 1, .Warning, "AI-PHRASE", "“the \u212aey takeaway” reads as machine prose. If the point is the point, just make it.", "the \u212aey takeaway and \u0130 seamless", ""},
			{1, 24, .Warning, "AI-PHRASE", "“seamless” reads as machine prose. Empty intensifier. Say what actually happens.", "the \u212aey takeaway and \u0130 seamless", ""},
		},
	},
	// Four digits before the comma, four after it, or a word character in
	// front: no thousands separator.
	{
		lang = "de",
		text = "Es kostet 5,000 Euro, 12,3456 nicht, 1234,567 nicht, x5,000 nicht, 9,999.",
		note = "language: de",
		want = {
			{1, 11, .Warning, "DE-THOUSANDS", "Looks like an English thousands separator in German text. German writes 5.000, not 5,000.", "Es kostet 5,000 Euro, 12,3456 nicht, 1234,567 nic…", "5.000"},
			{1, 68, .Warning, "DE-THOUSANDS", "Looks like an English thousands separator in German text. German writes 5.000, not 5,000.", "…ht, 1234,567 nicht, x5,000 nicht, 9,999.", "9.999"},
		},
	},
	// The matches do not overlap, so the "b" that ends one double space
	// cannot start the next, and "b  c" goes unreported.
	{
		lang = "en",
		text = "a  b  c and d   e",
		note = "language: en",
		want = {
			{1, 2, .Warning, "DOUBLE-SPACE", "More than one space between words.", "a  b  c and d   e", "single space"},
			{1, 14, .Warning, "DOUBLE-SPACE", "More than one space between words.", "a  b  c and d   e", "single space"},
		},
	},
	// Punctuation at the end of a line and at the end of the text.
	{
		lang = "en",
		text = "Wait , what ;\nend !",
		note = "language: en",
		want = {
			{1, 5, .Error, "SPACE-BEFORE-PUNCT", "Space before punctuation.", "Wait , what ;", ","},
			{1, 12, .Error, "SPACE-BEFORE-PUNCT", "Space before punctuation.", "Wait , what ;", ";"},
			{2, 4, .Error, "SPACE-BEFORE-PUNCT", "Space before punctuation.", "end !", "!"},
		},
	},
	// Only the last digit is reported, and non-ASCII units count.
	{
		lang = "de",
		text = "Es hat 40°C und 5€ und 12kg und 3TB.",
		note = "language: de",
		want = {
			{1, 9, .Error, "DE-UNIT-SPACE", "German typography puts a space between number and unit: 0 °C.", "Es hat 40°C und 5€ und 12kg und 3TB.", "0 °C"},
			{1, 17, .Error, "DE-UNIT-SPACE", "German typography puts a space between number and unit: 5 €.", "Es hat 40°C und 5€ und 12kg und 3TB.", "5 €"},
			{1, 25, .Error, "DE-UNIT-SPACE", "German typography puts a space between number and unit: 2 kg.", "Es hat 40°C und 5€ und 12kg und 3TB.", "2 kg"},
			{1, 33, .Error, "DE-UNIT-SPACE", "German typography puts a space between number and unit: 3 TB.", "Es hat 40°C und 5€ und 12kg und 3TB.", "3 TB"},
		},
	},
	// A word character in front hides an abbreviation.
	{
		lang = "de",
		text = "Das ist z.B. gut, d.h. klar, xz.B. nicht, i.d.R. ja.",
		note = "language: de",
		want = {
			{1, 9, .Warning, "DE-ABBREV-SPACE", "DIN 5008 spaces multi-part abbreviations: z. B.", "Das ist z.B. gut, d.h. klar, xz.B. nicht, i.d.…", "z. B."},
			{1, 19, .Warning, "DE-ABBREV-SPACE", "DIN 5008 spaces multi-part abbreviations: d. h.", "Das ist z.B. gut, d.h. klar, xz.B. nicht, i.d.R. ja.", "d. h."},
			{1, 43, .Warning, "DE-ABBREV-SPACE", "DIN 5008 spaces multi-part abbreviations: i. d. R.", "…z.B. gut, d.h. klar, xz.B. nicht, i.d.R. ja.", "i. d. R."},
		},
	},
	// Nothing, and nothing but white space.
	{lang = "auto", text = "", note = "language: unknown", want = {}},
	{lang = "auto", text = "   \n\n\t\n", note = "language: unknown", want = {}},
	// The longest phrase starting at a position wins, and the case of the
	// source is kept in the message.
	{
		lang = "en",
		text = "This is seamlessly done, seamless too. Delve into it.",
		note = "language: en",
		want = {
			{1, 9, .Warning, "AI-PHRASE", "“seamlessly” reads as machine prose. Empty intensifier. Say what actually happens.", "This is seamlessly done, seamless too. Delve into it…", ""},
			{1, 26, .Warning, "AI-PHRASE", "“seamless” reads as machine prose. Empty intensifier. Say what actually happens.", "This is seamlessly done, seamless too. Delve into it.", ""},
			{1, 40, .Warning, "AI-PHRASE", "“Delve into” reads as machine prose. Register mismatch with the rest of your notes.", "…is seamlessly done, seamless too. Delve into it.", ""},
		},
	},
	// The first two connectives pass; the third and later are reported.
	{
		lang = "de",
		text = "Darüber hinaus gilt es. Zudem gilt es. Ferner gilt es. Überdies auch.",
		note = "language: de",
		want = {
			{1, 40, .Warning, "DE-GLUE", "4 additive connectives in one document. Used this often they stop connecting and start padding.", "…er hinaus gilt es. Zudem gilt es. Ferner gilt es. Überdies auch.", "drop it, or replace with a real logical link"},
			{1, 56, .Warning, "DE-GLUE", "4 additive connectives in one document. Used this often they stop connecting and start padding.", "…s. Zudem gilt es. Ferner gilt es. Überdies auch.", "drop it, or replace with a real logical link"},
		},
	},
	// A trailing legend emoji excuses a heading; a leading one that recurs
	// does not excuse a second emoji in the same heading.
	{
		lang = "auto",
		text = "# 🚀 Start\n\nText 🚀 here.\n\n## Done 🎉\n\nA 🎉 and 🎉.\n\n## ✅ One ✅\n",
		note = "language: en",
		want = {
			{3, 6, .Note, "EMOJI-LEGEND", "🚀 also labels a heading here, so it reads as a pointer to that section. Left alone.", "Text 🚀 here.", "no action unless you meant it as decoration"},
			{7, 3, .Note, "EMOJI-LEGEND", "🎉 appears 2× in body text, so it reads as a legend rather than decoration. Left alone.", "A 🎉 and 🎉.", "no action unless you meant it as decoration"},
			{9, 10, .Warning, "EMOJI-COUNT", "2 emoji in one heading. One label reads as a label, two read as decoration.", "## ✅ One ✅", "keep the one that names the section"},
		},
	},
	{
		lang = "en",
		text = "He said \"a\" and \"b\" and „c“ here.",
		note = "language: en",
		want = {
			{1, 9, .Warning, "QUOTE-MIX", "Both typographic quotes (2) and straight quotes (4) in one document. Pick one and hold it.", "He said \"a\" and \"b\" and „c“ here.", "„…“ for polished German, straight quotes for notes"},
		},
	},
	// A heading and a dash inside a fence are code.
	{lang = "auto", text = "```\n# 🚀 not a heading \u2014 code\n```\n", note = "language: en", want = {}},
}
// odinfmt: enable

@(test)
snippets_match_the_reference :: proc(t: ^testing.T) {
	for s, n in SNIPPETS {
		result, err := prose.check_text(s.text, {lang = s.lang})
		defer prose.file_result_destroy(&result)
		testing.expectf(t, err.message == "", "snippet %d: error %q", n, err.message)
		testing.expectf(t, result.note == s.note, "snippet %d: note %q, reference %q", n, result.note, s.note)
		expect_findings(t, "snippet", n, result.findings, s.want)
	}
}

// expect_findings compares two finding lists field by field and in order,
// and names the first difference.
expect_findings :: proc(t: ^testing.T, what: string, n: int, got, want: []prose.Finding) -> bool {
	for i in 0 ..< min(len(got), len(want)) {
		g, w := got[i], want[i]
		if g != w {
			testing.expectf(t, false, "%s %d: finding %d is\n  %v\nreference\n  %v", what, n, i, g, w)
			return false
		}
	}
	if len(got) != len(want) {
		extra := got[len(want):] if len(got) > len(want) else want[len(got):]
		testing.expectf(t, false, "%s %d: %d findings, reference %d; first unmatched: %v", what, n, len(got), len(want), extra[0])
		return false
	}
	return true
}

// Findings sort by line, column and rule, so a rule added later can come
// first, and findings equal in all three keep the order they came in. No
// corpus file has such a tie without LanguageTool, so it is tested here.
@(test)
findings_sort_by_line_col_and_rule_stably :: proc(t: ^testing.T) {
	fs := [?]prose.Finding {
		{line = 2, col = 1, rule = "A", message = "last line"},
		{line = 1, col = 5, rule = "SPACE-BEFORE-PUNCT", message = "first"},
		{line = 1, col = 5, rule = "LT:QB_NEW_EN_OTHER", message = "lt"},
		{line = 1, col = 5, rule = "SPACE-BEFORE-PUNCT", message = "second"},
		{line = 1, col = 2, rule = "Z", message = "early column"},
	}
	prose.sort_findings(fs[:])
	want := [?]string{"early column", "lt", "first", "second", "last line"}
	for w, i in want {
		testing.expectf(t, fs[i].message == w, "position %d holds %q, want %q", i, fs[i].message, w)
	}
}

// A phrase after dotted capital I's is found where it is. The reference
// lowered each to two code points, so it reported the hit one column late
// per I, quoted the wrong text, and with nine of them looked past the end of
// the source and raised IndexError. Hand-written, since the reference's
// answer is the bug.
@(test)
a_phrase_after_a_dotted_capital_i_keeps_its_column :: proc(t: ^testing.T) {
	text := "\u0130\u0130\u0130\u0130\u0130\u0130\u0130\u0130\u0130 nahtlos"
	result, err := prose.check_text(text, {lang = "de"})
	defer prose.file_result_destroy(&result)
	testing.expect_value(t, err.message, "")
	if !testing.expect_value(t, len(result.findings), 1) {
		return
	}
	f := result.findings[0]
	testing.expect_value(t, f.rule, "AI-PHRASE")
	testing.expect_value(t, f.line, 1)
	testing.expect_value(t, f.col, 11)
	testing.expect_value(t, f.message, "\u201cnahtlos\u201d reads as machine prose. Leere Verstärkung. Sag, was passiert.")
	testing.expect_value(t, f.excerpt, text)
}

// Python's lower() turns the dotted capital I into "i" and a combining dot, so
// the reference never matched "in conclusion" in "\u0130n conclusion". The
// port lowers it to "i" alone and flags the phrase, in the right column.
// Hand-written: the port is wider than the reference here, on purpose.
@(test)
a_phrase_that_starts_with_a_dotted_capital_i_is_flagged :: proc(t: ^testing.T) {
	text := "Intro. \u0130n conclusion, it works."
	result, err := prose.check_text(text, {lang = "en"})
	defer prose.file_result_destroy(&result)
	testing.expect_value(t, err.message, "")
	hits := 0
	for f in result.findings {
		if f.rule != "AI-PHRASE" {
			continue
		}
		hits += 1
		testing.expect_value(t, f.line, 1)
		testing.expect_value(t, f.col, 8)
		testing.expect_value(t, f.message, "\u201c\u0130n conclusion\u201d reads as machine prose. A note does not need a conclusion section.")
	}
	testing.expect_value(t, hits, 1)
}

// Findings equal in line, column and rule keep the order they came in. Five
// elements sort by insertion and cannot tell a stable sort from an unstable
// one, so this has 400 findings in 3 keys, in an order a quicksort would
// scramble, each carrying its arrival number.
@(test)
equal_findings_keep_their_arrival_order_in_a_long_list :: proc(t: ^testing.T) {
	N :: 400
	fs := make([]prose.Finding, N)
	defer delete(fs)
	messages := make([]string, N)
	defer {
		for m in messages {
			delete(m)
		}
		delete(messages)
	}
	x := u32(12345)
	for i in 0 ..< N {
		x = x * 1664525 + 1013904223
		key := int(x >> 24) % 3
		messages[i] = fmt.aprintf("%d", i)
		fs[i] = prose.Finding {
			line    = 1,
			col     = 1 + key,
			rule    = "R",
			message = messages[i],
		}
	}
	prose.sort_findings(fs)
	for i in 1 ..< N {
		a, b := fs[i - 1], fs[i]
		if a.col > b.col {
			testing.expectf(t, false, "position %d: column %d before column %d", i, a.col, b.col)
			return
		}
		if a.col == b.col {
			an, _ := strconv.parse_int(a.message)
			bn, _ := strconv.parse_int(b.message)
			if an > bn {
				testing.expectf(t, false, "position %d: arrival %d sorted before arrival %d", i, an, bn)
				return
			}
		}
	}
}
